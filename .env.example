# NEST CRM — environment configuration (example). Copy to .env for local use, or set these as
# Railway variables / secrets in deployment. NEVER commit real secrets. Placeholders only here.

# Runtime
SPRING_PROFILES_ACTIVE=production
# PORT is injected by Railway; locally the app defaults to 8080.
PORT=8080

# --- Database (Neon) ---
# Pooled runtime connection, converted to a pgJDBC URL (jdbc:postgresql://...). Include the TLS
# parameters Neon recommends for pgJDBC (e.g. ?sslmode=require).
SPRING_DATASOURCE_URL=jdbc:postgresql://<pooled-neon-host>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<application-role>
SPRING_DATASOURCE_PASSWORD=<secret>

# Direct (non-pooled) connection used only for Flyway migrations.
MIGRATION_JDBC_URL=jdbc:postgresql://<direct-neon-host>/<database>?sslmode=require
MIGRATION_DB_USERNAME=<migration-role>
MIGRATION_DB_PASSWORD=<secret>

# Connection pool (keep small for serverless Postgres; tune from load measurements).
DB_POOL_MAX=5
DB_POOL_MIN=1

# --- Application ---
APP_BASE_URL=https://<application-domain>
APP_DEFAULT_TIMEZONE=Asia/Kolkata
# Inventory freshness policy (days) — agree this with the brokerage; no universal default is assumed.
INVENTORY_FRESHNESS_DAYS=30

# --- Integrations (Milestone 4) ---
# Outbound delivery provider. 'simulated' does NOT send anything (marks messages SIMULATED_SENT).
# Wire a real provider only after account setup, permission rules and duplicate-delivery checks.
DELIVERY_PROVIDER=simulated
# Background workers (reminders + outbox). Keep enabled in the app; disabled only in tests.
SCHEDULING_ENABLED=true
SCHEDULING_REMINDERS_MS=60000
SCHEDULING_OUTBOX_MS=15000
# Serve the session cookie as Secure in production (HTTPS).
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT=12h

# --- One-time owner bootstrap ---
# Set bootstrap=true once with an email + password to create the single owner, then set it back to
# false. The password is used only to create the hash and is never stored or logged.
APP_OWNER_BOOTSTRAP=false
APP_OWNER_EMAIL=
APP_OWNER_PASSWORD=
APP_OWNER_WORKSPACE_NAME=NEST
APP_OWNER_WORKSPACE_TIMEZONE=Asia/Kolkata

# --- AI coach (Milestone 2) — disabled until a provider is verified ---
AI_ENABLED=false
AI_PROVIDER=mock
AI_MODEL=<verified-supported-model-id>
AI_API_KEY=
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=1500
AI_DAILY_BUDGET_USD=0
